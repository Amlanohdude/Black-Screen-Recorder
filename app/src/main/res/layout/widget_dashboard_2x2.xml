<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_idle"
    android:orientation="vertical"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Top header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BLACK SCREEN RECORDER"
            android:textColor="#7A7A85"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#222228"
            android:text="READY"
            android:textColor="#8E8E93"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Action Zone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_widget_rec_idle"
            android:contentDescription="@string/widget_quick_record_name" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_quick_record_name"
            android:textColor="#F5F5F7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to Start Recording"
            android:textColor="#8E8E93"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Footer Row -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Discreet · Screen Kept Dark"
        android:textColor="#666672"
        android:textSize="8sp" />

</LinearLayout>
